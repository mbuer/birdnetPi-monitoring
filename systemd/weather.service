# /etc/systemd/system/weather.service
[Unit]
Description=Weather Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=birduser
WorkingDirectory=/home/birduser/weather
ExecStart=/usr/bin/python3 -u /home/birduser/weather/weather.py
Restart=always
RestartSec=30


# Automatically create a log entry in the journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
