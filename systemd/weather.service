# /etc/systemd/system/weather.service

[Unit]
Description=BirdNET Weather Logger
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=simple
User=birduser
WorkingDirectory=/home/birduser/weather
ExecStart=/usr/bin/python3 -u /home/birduser/weather/weather.py
Restart=always
RestartSec=30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
